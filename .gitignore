# GSR de referencia: GPL-3.0 de terceros. Vive FUERA del repo, en
# ~/Desktop/app-audio/referencia/gpu-screen-recorder/. Esta linea se queda como
# red por si alguien vuelve a dejar una copia aqui dentro: el repo no
# redistribuye GSR ni su codigo.
third_party/

# Notas internas: encargo, estado y prompts de trabajo. No son documentacion
# del proyecto y no van al remoto.
docs/interno/

build/
build-*/

# Lo que deja flatpak-builder: el arbol de construccion, la cache de estado y
# el repositorio ostree local. Son cientos de ficheros y se regeneran con un
# comando; ademas descuadran `reuse lint`, que cuenta todo lo que hay en el
# arbol.
salida-flatpak/
.flatpak-builder/

# Lo que deja dpkg-buildpackage dentro del arbol fuente. El .deb sale al
# directorio padre, que ya esta fuera del repositorio.
debian/easy-screen-recorder/
debian/.debhelper/
debian/files
debian/*.substvars
debian/*.debhelper.log
debian/debhelper-build-stamp
debian/tmp/

compile_commands.json
.cache/
*.user
